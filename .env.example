# Apple Store Connect API Configuration
APPLE_KEY_ID=your_key_id_here
APPLE_ISSUER_ID=your_issuer_id_here

# Apple Store Connect API Private Key (keep this secure!)
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
your_private_key_content_here
-----END PRIVATE KEY-----"

# Optional: vendor number for get_sales_data (Sales and Trends units and proceeds).
# Find it in App Store Connect -> Reports (top left, under your legal entity name).
APPLE_VENDOR_NUMBER=

# Server Configuration
PORT=3992
# The server has no auth and uses your API key. Keep it on loopback.
HOST=127.0.0.1
# Optional comma-separated browser origins. Leave unset; MCP clients do not need CORS.
# CORS_ORIGIN=
